{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scorecard",
  "type": "object",
  "required": ["period", "generated_at", "network", "agents"],
  "properties": {
    "period": { "type": "string", "description": "e.g. 2026-W45 or 2026-11-02" },
    "generated_at": { "type": "string", "format": "date-time" },
    "network": {
      "type": "object",
      "properties": {
        "time_to_first_response_days": { "$ref": "#/$defs/dist" },
        "time_to_merge_days": { "$ref": "#/$defs/dist" },
        "community_size": { "type": "integer" },
        "new_contributors": { "type": "integer" },
        "retention_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "pr_closure_ratio": { "type": "number" },
        "spend_usd_month_to_date": { "type": "number" },
        "spend_usd_forecast_month": { "type": "number" }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "spend_usd": { "type": "number" },
          "sessions": { "type": "integer" },
          "tokens": { "type": "integer" },
          "model_mix": { "type": "object", "additionalProperties": { "type": "number" } },
          "outcomes": { "type": "object", "additionalProperties": { "type": "integer" } },
          "cost_per_outcome_usd": { "type": "object", "additionalProperties": { "type": "number" } },
          "decisions": {
            "type": "object",
            "properties": {
              "approved": { "type": "integer" },
              "approved_with_edits": { "type": "integer" },
              "rejected": { "type": "integer" },
              "open": { "type": "integer" }
            }
          },
          "kpis": { "type": "object" },
          "flags": { "type": "array", "items": { "type": "string" } },
          "evidence": {
            "type": "object",
            "description": "Weekly only: what went wrong, quoted as data, for Ada's proposals",
            "properties": {
              "rejections": { "type": "array", "items": { "$ref": "#/$defs/group" } },
              "refusals": { "type": "array", "items": { "$ref": "#/$defs/group" } },
              "denials": { "type": "array", "items": { "$ref": "#/$defs/group" } },
              "blockers": { "type": "array", "items": { "$ref": "#/$defs/group" } },
              "dismissed_findings": { "type": "array", "items": { "$ref": "#/$defs/group" } }
            }
          }
        }
      }
    },
    "changes": {
      "type": "array",
      "description": "Weekly only: changes measured in the period, from read_audit",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "agent": { "type": "string" },
          "type": { "type": "string" },
          "measure": { "type": "string" },
          "verdict": { "enum": ["better", "same", "worse", "too_little_data"] },
          "before": { "type": ["number", "null"] },
          "after": { "type": ["number", "null"] },
          "before_cases": { "type": "integer" },
          "after_cases": { "type": "integer" },
          "overlaps": { "type": "array", "items": { "type": "string" } },
          "pr_url": { "type": ["string", "null"] }
        }
      }
    },
    "anomalies": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "group": {
      "type": "object",
      "description": "Rows that say the same thing: a one-line summary, quoted text, and every id",
      "properties": {
        "summary": { "type": "string" },
        "tool": { "type": "string" },
        "quotes": { "type": "array", "items": { "type": "string" } },
        "ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "dist": {
      "type": "object",
      "properties": {
        "n": { "type": "integer" },
        "mean": { "type": "number" },
        "median": { "type": "number" },
        "p90": { "type": "number" }
      }
    }
  }
}
