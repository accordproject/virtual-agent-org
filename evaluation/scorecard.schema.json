{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scorecard",
  "type": "object",
  "required": ["period", "generated_at", "network", "agents"],
  "properties": {
    "period": { "type": "string", "description": "e.g. 2026-W45 or 2026-11-02" },
    "generated_at": { "type": "string", "format": "date-time" },
    "network": {
      "type": "object",
      "properties": {
        "time_to_first_response_days": { "$ref": "#/$defs/dist" },
        "time_to_merge_days": { "$ref": "#/$defs/dist" },
        "community_size": { "type": "integer" },
        "new_contributors": { "type": "integer" },
        "retention_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "pr_closure_ratio": { "type": "number" },
        "spend_usd_month_to_date": { "type": "number" },
        "spend_usd_forecast_month": { "type": "number" }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "spend_usd": { "type": "number" },
          "sessions": { "type": "integer" },
          "tokens": { "type": "integer" },
          "model_mix": { "type": "object", "additionalProperties": { "type": "number" } },
          "outcomes": { "type": "object", "additionalProperties": { "type": "integer" } },
          "cost_per_outcome_usd": { "type": "object", "additionalProperties": { "type": "number" } },
          "decisions": {
            "type": "object",
            "properties": {
              "approved": { "type": "integer" },
              "approved_with_edits": { "type": "integer" },
              "rejected": { "type": "integer" },
              "open": { "type": "integer" }
            }
          },
          "kpis": { "type": "object" },
          "flags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "anomalies": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "dist": {
      "type": "object",
      "properties": {
        "n": { "type": "integer" },
        "mean": { "type": "number" },
        "median": { "type": "number" },
        "p90": { "type": "number" }
      }
    }
  }
}
